<!DOCTYPE html>
<html lang="en">

<head>
{% include "partials/inspector-splash.njk" %}

<!--------->
<!-- metadata -->
<!--------->

  {# <!-- site data now usable to DOM --> #}
  <script>
    window.siteData = {{ siteData | dump | safe }};
  </script>

  {# <!-- index? --> #}
  {# add variable to nunjucks page frontmatter if it shouldn't be indexed; i.e. noIndex: true #}
  {% if noIndex %}
    <meta name="ROBOTS" content="NOINDEX, NOFOLLOW">
  {% endif %}

  {# add variable to nunjucks page frontmatter if it should redirect; i.e. redirectUrl: https://example.com #}
  {% if redirectUrl %}
    <meta http-equiv="Refresh" content="0; url={{ redirectUrl }}">
  {% endif %}

  <link rel="canonical" href="{{ page.url | canonicalUrl(site) }}">

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ site.title }}{% if subtitle %}: {{ subtitle }}{% endif %}</title>

  <meta name="description" content="{% if subdescription %}{{ subdescription }}{% else %}{{ site.description }}{% endif %}">
  <meta name="author" content="{{ site.author }}">
  <meta name="keywords" content="{% if site.keywords %}: {{ site.keywords }}, {% endif %}{{ keywords }}">

  {# if applicable/desired (default: TB green) #}
  <meta name="theme-color" content="{{ site.accentColor | default('#0A8C61') }}">

  {# Open Graph meta tags for social media sharing #}

  {# Open Graph meta tags #}
  <meta property="og:title" content="{{ site.title }}{% if subtitle %}: {{ subtitle }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}">
  <meta property="og:url" content="{{ page.url | canonicalUrl(site) }}">
  <meta property="og:description" content="{% if subdescription %}{{ subdescription }}{% else %}{{ site.description }}{% endif %}">
  <meta property="og:image" content="{{ site.url }}/img/meta/og-image.png">
  <meta property="og:image:width" content="1800">
  <meta property="og:image:height" content="945">
  <meta property="og:image:type" content="image/png">
  <meta name="twitter:card" content="summary">

  {# favicons #}
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

<!--------->
<!-- css -->
<!--------->

  <!-- fonts -->
  {% if site.fonts or site.fontsCss %}
    {% if site.fontsCss %}
      <link rel="stylesheet" href="{{ site.fontsCss }}">
    {% endif %}
    {% if site.fonts %}
      {% if site.fonts is string %}
        <link rel="preload" href="{{ site.fonts }}" as="font" type="font/woff2" crossorigin>
      {% else %}
        {% for font in site.fonts %}
          <link rel="preload" href="{{ font }}" as="font" type="font/woff2" crossorigin>
        {% endfor %}
      {% endif %}
    {% endif %}
  {% elif site.fontsRel %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="{{ site.fontsRel }}" rel="stylesheet">
  {% endif %}

  {% if site.iconsRel %}
  <!-- icons -->
  <script src="{{ site.iconsRel }}"></script>
  {% endif %}

  <!-- frameworks -->
  <link rel="stylesheet" type="text/css" href="https://au.goldenharpmedia.com/framework/packages/v1.1.1/au.css">
  {% block additionalFrameworks %}{% endblock %}

  <!-- shared Terrabyte styles -->
  <link rel="stylesheet" href="/css/global-tb-styles.css">
  <link rel="stylesheet" href="/css/global-tb-ui-styles.css">

  {# DEPRECATE: Utilize the additionalSiteStyles block on a per-project basis #}
  {% if site.styleType == "pixel" %}
    <!-- shared pixel art styles -->
    <link rel="stylesheet" href="/css/shared-pixel-styles.css">
  {% endif %}

  {# Shared project styles, if applicable #}
  {% if site.project == "Canapi" %}
  <!-- shared project styles for {{ site.project }} -->
    <link rel="stylesheet" href="/css/shared-canapi-styles.css">
  {% endif %}

  <!-- additional shared styles for specific projects or project groupings (if applicable) -->
  {% block additionalSharedStyles %}{% endblock %}

  <!-- site styles -->
  <link rel="stylesheet" href="/css/site-styles.css">
  {% block additionalSiteStyles %}{% endblock %}

  {% if styles %}
  <!-- page styles -->
    {% if styles is string %}
      <link rel="stylesheet" href="{{ styles }}">
    {% else %}
      {% for style in styles %}
        <link rel="stylesheet" href="{{ style }}">
      {% endfor %}
    {% endif %}
  {% endif %}


  {# other conditional styles; i.e. text-page styles #}
  {% block additionalConditionalStyles %}{% endblock %}
  {# {% if testPage %} #}
    {# <link href="/css/test-styles.css" rel="stylesheet" type="text/css" /> #}
  {# {% else %} #}
    {# <link href="/css/other-styles.css" rel="stylesheet" type="text/css" /> #}
  {# {% endif %} #}

<!--------->
<!-- js -->
<!--------->

  <!-- schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{{ site.schemaType | default('Thing') }}",
      "name": "{{ site.project }}",
      "url": "{{ site.url }}",
      "logo": "{{ site.url }}/img/meta/logo.png",
      "description": "{% if subdescription %}{{ subdescription }}{% else %}{{ site.description }}{% endif %}"
      {% if site.sameAs %},"sameAs": {{ site.sameAs | dump }}{% endif %}
    }
  </script>

  <!-- shared Terrabyte scripts -->
  <script src="/js/global-tb-scripts.js" defer></script>

  <!-- site scripts -->
  <script src="/js/site-scripts.js" defer></script>
  {% block additionalSiteScripts %}{% endblock %}

  {% if scripts %}
  <!-- page scripts -->
    {% if scripts is string %}
      <script src="{{ scripts }}" defer></script>
    {% else %}
      {% for script in scripts %}
        <script src="{{ script }}" defer></script>
      {% endfor %}
    {% endif %}
  {% endif %}


<!--------->
<!-- analytics & APIs -->
<!--------->

  <!-- microanalytics -->
  {# <script data-host="https://microanalytics.io" data-dnt="false" src="https://microanalytics.io/js/script.js" id="ZwSg9rf6GA" async defer></script> #}
  {# new "app" endpoint #}
  <script data-host="https://app.microanalytics.io" data-dnt="false" src="https://app.microanalytics.io/js/script.js" id="ZwSg9rf6GA" async defer></script>

  {% if site.canapiKey %}
  <!-- canapi -->
    <script type="text/javascript" data-canapi-init data-host="https://app.canapi.io" src="https://app.canapi.io/canapi.js" defer></script>
  {% endif %}
  
</head>

<body data-theme="{{ site.defaultTheme | default('system') }}">
  {# IMMEDIATE: load color theme, if previously set, to limit FOUC #}
  <script>
    (function(){
      var s = localStorage.getItem("colorTheme");
      var d = "{{ site.defaultTheme | default('system') }}";
      if(s) document.body.setAttribute("data-theme", s);
      else document.body.setAttribute("data-theme", d);
    })();
  </script>
{# ########## #}
{# dependencies #}
{# ########## #}

  {# svg container component #}
  {% block icons %}
    {% include "partials/svgs.njk" %}
  {% endblock %}

{# ########## #}
{# sys ui #}
{# ########## #}

  {# modals (not supported atm...) #}
  {# {% include "modals.njk" %} #}

  {# accessibility/screen reader TOC #}
  {# handled as .eleventy.js transform #}

  {% block banners %}
    {% include "partials/banners.njk" %}
  {% endblock %}

  {% block toasts %}
    <div data-toast-container class="toasts-container" data-au="flex-container flex-column xsmall-gap"></div>
  {% endblock %}
  

{# ########## #}
{# page content begins #}
{# ########## #}

  <a name="top"></a>
  {# inject whatever header makes sense per-project basis #}
  {% block header %}
  {% endblock %}

  <main>
    {{ content | safe }}
  </main>

  <a name="footer"></a>
  {# inject whatever footer makes sense per-project basis #}
  {% block footer %}
  {% endblock %}

</body>
</html>